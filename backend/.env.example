DATABASE_URL=sqlite:///./sahyog.db

# Supabase Storage Integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rag-documents

# RAG Embedding Configuration (Ollama — stays local)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIMENSIONS=1024
OLLAMA_API_URL=http://localhost:11434

# Gemini LLM — replacement for Qwen
LLM_PROVIDER=gemini
GEMINI_LLM_API_KEY=your_llm_gemini_api_key
GEMINI_LLM_MODEL=your_llm_model

# Gemini TTS
GEMINI_TTS_API_KEY=your_tts_gemini_api_key
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Ollama LLM fallback (set LLM_PROVIDER=ollama to use)
# LLM_MODEL=qwen3:8b
# LLM_TIMEOUT=180
